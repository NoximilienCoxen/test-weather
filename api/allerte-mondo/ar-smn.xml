    color:#666;
    font-size:12px;
    margin-top:8px;
}

.descripcion{
    margin-top:12px;
    line-height:1.5;
    color:#222;
}

.link{
    margin-top:15px;
}

.link a{
    background:#cc0000;
    color:white;
    padding:8px 12px;
    border-radius:4px;
    text-decoration:none;
    font-size:14px;
    font-weight:bold;
}

