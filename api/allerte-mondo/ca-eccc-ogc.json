,[-58.05271962,49.60400285],[-58.21713547,49.50050412],[-58.29961304,49.43632623],[-58.30624005,49.42525855],[-58.24020481,49.39804081],[-58.23910534,49.39760853],[-58.23821827,49.39725974],[-58.22239703,49.3903117],[-57.68592162,49.15190046],[-57.68275833,49.15047836]]]},"properties":{"alert_code":"SPS","alert_type":"statement","alert_name_en":"special weather statement","alert_name_fr":"bulletin m\u00e9t\u00e9orologique sp\u00e9cial","alert_short_name_en":"Special weather","alert_short_name_fr":"M\u00e9t\u00e9orologique sp\u00e9cial","publication_datetime":"2026-11-11T02:29:21.940Z","expiration_datetime":"2026-11-11T18:29:21.940Z","validity_datetime":"2026-11-11T10:00:00.000Z","event_end_datetime":"2026-11-12T18:00:00.000Z","alert_text_en":"Accumulating snowfall is expected inland and over higher terrain.\n\nLocations: Gros Morne to Hawkes Bay. \n\nPotential snowfall: 20 to 30 cm, highest over elevated terrain. \n\nTime span: Wednesday morning until Thursday evening. \n\nRemarks: Snow will accumulate steadily inland and over higher terrain while rain, or rain mixed with snow, is expected near the coast.\n\nSnow may lead to adverse travel conditions, with slippery conditions in some locations, particularly over higher elevations.\n\nBe prepared for winter driving conditions, keep a snow brush handy, and allow extra time to reach your destination.\n\nPlease continue to monitor alerts and forecasts issued by Environment Canada. To report severe weather, send an email to NLstorm@ec.gc.ca or post reports on social media using #NLwx.","alert_text_fr":"On pr\u00e9voit une accumulation de neige \u00e0 l'int\u00e9rieur des terres et en terrain montagneux.\n\nR\u00e9gions : de Gros-Morne jusqu'\u00e0 Hawke's Bay.\n\nAccumulation de neige possible : de 20 \u00e0 30 cm; quantit\u00e9s les plus importantes en secteurs montagneux.\n\nP\u00e9riode : de mercredi matin \u00e0 jeudi soir.\n\nRemarques : la neige s'accumulera peu \u00e0 peu dans l'int\u00e9rieur et en secteurs montagneux, tandis que de la pluie ou de la pluie m\u00eal\u00e9e de neige est attendue pr\u00e8s de la c\u00f4te.\n\nLa neige pourrait rendre les conditions routi\u00e8res difficiles et glissantes \u00e0 certains endroits, surtout en secteurs montagneux.\n\nSoyez pr\u00eats \u00e0 composer avec des conditions routi\u00e8res hivernales, gardez un balai \u00e0 neige \u00e0 port\u00e9e de main et pr\u00e9voyez plus de temps pour vous rendre \u00e0 destination.\n\nVeuillez continuer \u00e0 surveiller les alertes et les pr\u00e9visions \u00e9mises par Environnement Canada. Pour signaler du temps violent, envoyez un courriel \u00e0 meteoNL@ec.gc.ca ou publiez un message sur les r\u00e9seaux sociaux en utilisant #NLMeteo.","risk_colour_en":null,"risk_colour_fr":null,"confidence_en":null,"confidence_fr":null,"impact_en":null,"impact_fr":null,"feature_name_en":"Gros Morne","feature_name_fr":"Gros-Morne","province":"NL","status_en":"continued","status_fr":"maintenu","feature_id":"fea1-867"}}],"numberMatched":137,"numberReturned":3,"links":[{"type":"application/geo+json","rel":"self","title":"This document as GeoJSON","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=json&limit=3"},{"rel":"alternate","type":"application/ld+json","title":"This document as RDF (JSON-LD)","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=jsonld&limit=3"},{"type":"text/html","rel":"alternate","title":"This document as HTML","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=html&limit=3"},{"type":"application/geo+json","rel":"next","title":"Items (next)","href":"https://api.weather.gc.ca/collections/weather-alerts/items?offset=3&limit=3"},{"type":"application/json","title":"Weather Alerts","rel":"collection","href":"https://api.weather.gc.ca/collections/weather-alerts"}],"timeStamp":"2026-11-11T09:16:34.859189Z"}