<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Il cielo di mezzogiorno, gli stessi due toni che skyColors produce
         a quota piena: zenit #5A9BD4 in alto, orizzonte #C9E2F4 in basso.
         Il fondo di un'icona adattiva deve dipingere da bordo a bordo,
         perche' la maschera la decide il telefono. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:startColor="#FF5A9BD4" android:endColor="#FFC9E2F4">
            </gradient>
        </aapt:attr>
    </path>
</vector>
