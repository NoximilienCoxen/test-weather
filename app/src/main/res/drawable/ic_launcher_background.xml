<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!--
        Il cielo della prima sala a un'ora calda: pesca in alto, crema verso
        l'orizzonte. Sono due colori della tavolozza dell'app - `accent300` e il
        fondo `bg` di SalaTokens - perche' l'icona e la schermata che apre
        devono sembrare la stessa cosa.

        Il fondo dipinge da bordo a bordo: la maschera la decide il telefono.
    -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:startColor="#FFFFC6A5"
                android:centerColor="#FFFBDCC4"
                android:endColor="#FFF5EAD8" />
        </aapt:attr>
    </path>
</vector>
