    <path android:strokeColor="#FF3C8DF5" android:strokeWidth="2.8" android:strokeLineCap="round" android:pathData="M47,65 L44.6,72.4" />
    <path android:strokeColor="#FF3C8DF5" android:strokeWidth="2.8" android:strokeLineCap="round" android:pathData="M56.1,67.4 L53.7,74.8" />
    <path android:strokeColor="#FF3C8DF5" android:strokeWidth="2.8" android:strokeLineCap="round" android:pathData="M65.3,64.6 L62.9,72" />
</vector>
