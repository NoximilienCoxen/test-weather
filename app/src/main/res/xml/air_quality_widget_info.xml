<?xml version="1.0" encoding="utf-8"?>
<!--
    Due celle di lato: con una sola in altezza la riga sotto il numero restava
    tagliata fuori, ed e' quella che dice se piove. Resta allargabile fino a
    tutta la riga, dove il numero e la scritta si mettono affiancati.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.forli.meteo.widget.WidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout" />
